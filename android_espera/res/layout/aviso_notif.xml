<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de A Chess Way (AvisoVista.java): degradado gris, el logo del caballo en grande, título,
     texto y una pastilla con la acción. Solo vistas que admite RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aviso_raiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/aviso_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/aviso_logo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/aviso_marco_logo"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_large_achessway" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aviso_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aviso_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/aviso_pastilla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/aviso_pastilla"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="#FFF26A1E"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
