{
  "rules": {
    "abiertas": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !newData.exists() && data.child('creador').val() === auth.uid",
        "creador": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "latido": {
          ".write": "auth != null && newData.val() === now && (data.parent().child('creador').val() === auth.uid || newData.parent().child('creador').val() === auth.uid)"
        }
      }
    },
    "espera": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !newData.exists() && data.child('creador').val() === auth.uid",
        "creador": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && !root.child('vetados').child(auth.uid).exists()"
        },
        "latido": {
          ".write": "auth != null && newData.val() === now && (data.parent().child('creador').val() === auth.uid || newData.parent().child('creador').val() === auth.uid)"
        },
        "ritmo": {
          ".write": "auth != null && !data.exists() && newData.parent().child('creador').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(0\\+0|([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\\+([0-9]|[1-5][0-9]|60))$/)"
        },
        "no": {
          ".write": "auth != null && newData.parent().child('creador').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && newData.parent().parent().child('creador').val() === auth.uid",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "partidas": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('creador').val() === auth.uid || data.child('rival').val() === auth.uid)",
        "creador": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && !root.child('vetados').child(auth.uid).exists()"
        },
        "ritmo": {
          ".write": "auth != null && !data.exists() && newData.parent().child('creador').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(0\\+0|([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\\+([0-9]|[1-5][0-9]|60))$/)"
        },
        "rival": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('partidas').child($id).child('creador').exists() && root.child('partidas').child($id).child('creador').val() !== auth.uid && !root.child('vetados').child(auth.uid).exists()"
        },
        "unidoEn": {
          ".write": "auth != null && !data.exists() && newData.val() === now",
          ".validate": "newData.parent().child('rival').val() === auth.uid"
        },
        "listo": {
          ".write": "auth != null && !data.exists() && root.child('partidas').child($id).child('creador').val() === auth.uid && root.child('partidas').child($id).child('rival').exists()",
          ".validate": "newData.val() === now"
        },
        "jugadas": {
          "$n": {
            ".write": "auth != null && !data.exists() && (root.child('partidas').child($id).child('listo').exists() || (root.child('partidas').child($id).child('unidoEn').exists() && !root.child('partidas').child($id).child('ritmo').exists())) && !root.child('partidas').child($id).child('fin').exists() && (root.child('partidas').child($id).child('creador').val() === auth.uid || root.child('partidas').child($id).child('rival').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length <= 8"
          }
        },
        "pulsos": {
          "$n": {
            ".write": "auth != null && !data.exists() && root.child('partidas').child($id).child('listo').exists() && !root.child('partidas').child($id).child('fin').exists() && newData.parent().parent().child('jugadas').child($n).exists() && (root.child('partidas').child($id).child('creador').val() === auth.uid || root.child('partidas').child($id).child('rival').val() === auth.uid)",
            ".validate": "newData.val() === now"
          }
        },
        "sigo": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('partidas').child($id).child('listo').exists() && !root.child('partidas').child($id).child('fin').exists() && (root.child('partidas').child($id).child('creador').val() === auth.uid || root.child('partidas').child($id).child('rival').val() === auth.uid)",
            ".validate": "newData.val() === now"
          }
        },
        "fin": {
          ".write": "auth != null && !data.exists() && root.child('partidas').child($id).child('listo').exists() && (root.child('partidas').child($id).child('creador').val() === auth.uid || root.child('partidas').child($id).child('rival').val() === auth.uid)",
          ".validate": "newData.hasChildren(['tipo', 'pierde', 'de', 't'])",
          "tipo": {
            ".validate": "newData.val() === 'tiempo' || newData.val() === 'abandono'"
          },
          "pierde": {
            ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
          },
          "de": {
            ".validate": "newData.val() === auth.uid"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$otro": {
            ".validate": false
          }
        },
        "perfiles": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('partidas').child($id).child('creador').val() === auth.uid || root.child('partidas').child($id).child('rival').val() === auth.uid)",
            ".validate": "newData.hasChild('nivel')",
            "nivel": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 10"
            },
            "icono": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "foto": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            },
            "nombre": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
            },
            "juego": {
              ".validate": "newData.hasChildren(['r', 'rd', 'n'])",
              "r": {
                ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 3500"
              },
              "rd": {
                ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 350"
              },
              "n": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              },
              "$otro": {
                ".validate": false
              }
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "gestos": {
          "$g": {
            ".write": "auth != null && !data.exists() && root.child('partidas').child($id).child('unidoEn').exists() && (root.child('partidas').child($id).child('creador').val() === auth.uid || root.child('partidas').child($id).child('rival').val() === auth.uid)",
            ".validate": "newData.hasChildren(['de', 'g'])",
            "de": {
              ".validate": "newData.val() === auth.uid"
            },
            "g": {
              ".validate": "newData.isString() && newData.val().matches(/^(saludo|aplauso|genial|arriba|abajo|buena|tiempo)$/)"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      }
    },
    "denuncias": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['de', 'contra', 'motivo', 't'])",
        "de": {
          ".validate": "newData.val() === auth.uid"
        },
        "contra": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "partida": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "motivo": {
          ".validate": "newData.isString() && newData.val().matches(/^(nombre|trampas|abandono|conducta|otro)$/)"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "vetados": {
      ".read": false,
      ".write": false
    }
  }
}
