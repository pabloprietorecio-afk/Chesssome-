{
  "name": "chessome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chessome — prototipo MVP: problemas de ajedrez explicados, evaluación inicial adaptativa y tablero 3D",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build && node scripts/inline-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pipeline:import": "tsx pipeline/import-lichess.ts",
    "pipeline:analyze": "tsx pipeline/analyze.ts",
    "pipeline:report": "tsx pipeline/build-pack.ts",
    "golden": "tsx scripts/export-golden.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer-core": "^25.17.0",
    "stockfish": "^19.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
